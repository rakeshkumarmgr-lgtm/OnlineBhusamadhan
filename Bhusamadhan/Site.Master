<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Bhusamadhan.Site" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <title>भू-समाधान | बिहार सरकार</title>

    <%-- <link rel="icon" type="Image/x-icon" href="Image/favicon.ico" />--%>
    <link href="images/bihar_homedept_logo.png" rel="icon" />
    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback" />
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="plugins/fontawesome-free/css/all.min.css" />
    <!-- Theme style -->
    <link rel="stylesheet" href="dist/css/adminlte.min.css" />
    <link href="assets/css/sidebar1.css" rel="stylesheet" />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body class="hold-transition sidebar-mini">
    <form id="form1" runat="server" enctype="multipart/form-data">
        <asp:ScriptManager runat="server"></asp:ScriptManager>
        <div class="wrapper">
            <!-- Navbar -->
            <div class="main-header navbar navbar-expand navbar-white navbar-light">
                <!-- Left navbar links -->
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars"></i></a></li>
                    <li class="nav-item d-none d-sm-inline-block"><a href="#" class="nav-link">Home</a> </li>
                    <li class="nav-item d-none d-sm-inline-block"><a href="#" class="nav-link">Contact</a>
                    </li>
                </ul>
                <div class="col-sm-6  text-center">
                    <h5 class="m-0 text-info" style="color: white; font-family: 'Poppins', sans-serif; font-weight: 500">भू-समाधान | गृह विभाग | बिहार सरकार</h5>
                    <%-- <h6 class="m-0 text-info">Patna,Bihar</h6>--%>
                </div>
                <div class="text-center">
                    <img src="<%=ResolveClientUrl("images/nic1.png")%>" alt="NIC" />

                </div>

                <!-- Right navbar links -->
                <ul class="navbar-nav ml-auto">
                    <!-- Navbar Search -->
                    <li class="nav-item"><a class="nav-link" data-widget="navbar-search" href="#" role="button">
                        <i class="fas fa-search"></i></a>
                        <div class="navbar-search-block">
                            <div class="form-inline">
                                <div class="input-group input-group-sm">
                                    <input class="form-control form-control-navbar" type="search" placeholder="Search"
                                        aria-label="Search">
                                    <div class="input-group-append">
                                        <button class="btn btn-navbar" type="submit">
                                            <i class="fas fa-search"></i>
                                        </button>
                                        <button class="btn btn-navbar" type="button" data-widget="navbar-search">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>

                    <!-- Notifications Dropdown Menu -->
                    <li class="nav-item dropdown"><a class="nav-link" data-toggle="dropdown" href="#"><i
                        class="fas fa-cog fa-sm fa-fw" style='font-size: 20px; font-weight: bold;'></i><span class="badge badge-warning navbar-badge"></span>
                    </a>
                        <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right">
                            <span class="dropdown-header">

                                <%--<img src="dist/img/user1-128x128.jpg" alt="User Avatar" class="img-size-50 mr-3 img-circle">--%>
                            </span>
                            <asp:Label ID="lblUserName" runat="server" Text="username" CssClass="dropdown-item dropdown-footer text-left"></asp:Label>
                            <div class="dropdown-divider">
                            </div>
                            <asp:Label ID="lblUserID" runat="server" Text="UserId" CssClass="dropdown-item dropdown-footer text-left"></asp:Label>
                            <div class="dropdown-divider">
                            </div>

                            <a class="dropdown-item" href="Public/ChangePassword.aspx" style="color: Black">
                                <i class="fa fa-key mr-2 text-gray-400"></i>
                                Change Password
                            </a>
                            <div class="dropdown-divider"></div>

                            <a href="/Logout.aspx" class="dropdown-footer text-sm fas fa-sign-out-alt text-danger">Logout</a>

                            <div class="dropdown-divider">
                            </div>
                            <a href="#" class="dropdown-item dropdown-footer">Privacy Policy  • Terms of Service</a>
                        </div>
                    </li>

                </ul>
            </div>
            <!-- /.navbar -->
            <!-- Main Sidebar Container -->
            <div class="main-sidebar sidebar-dark-primary elevation-4">

                <!-- Brand Logo -->
                <a href="http://www.digitalindia.gov.in/" target="_blank" class="brand-link text-center" style="background: linear-gradient(to right, #1eb089 0%, #7c49ab 100%, #7bd9e8 100%) repeat scroll 0 0; color: white!important">

                    <span class="brand-text  text-center font-weight-bold text-white">गृह विभाग</span>
                </a>
                <!-- Sidebar -->
                <div class="sidebar">
                    <!-- Sidebar user panel (optional) -->
                    <div class="user-panel mt-3 pb-3 mb-3 d-flex">

                        <%-- <div class="info">
                            <a href="#" class="d-block">Dept of Home,Govt of Bihar</a>
                        </div>--%>
                        <span class="ml-5 text-danger font-weight-bold text-center ">
                            <asp:Label ID="lblName" runat="server"></asp:Label><br />
                            (
                            <asp:Label ID="lblUseridSidebar" runat="server"></asp:Label>
                            )
                            
                        </span>
                    </div>
                    <!-- SidebarSearch Form -->

                    <!-- Sidebar Menu -->
                    <nav class="mt-2">

                        <asp:PlaceHolder ID="phMenu" runat="server"></asp:PlaceHolder>

                    </nav>
                    <!-- /.sidebar-menu -->
                </div>
                <!-- /.sidebar -->
            </div>

            <!-- Main Sidebar Container ends here -->
            <!-- Content Wrapper. Contains page content -->
            <div class="content-wrapper">
                <!-- Content Header (Page header) -->
                <div class="content-header">
                    <div class="container-fluid">
                        <div class="row mb-1">
                            <div class="col-sm-3">
                                <%--<h1 class="m-0">Starter Page</h1>--%>
                                <asp:Label ID="lblDate" runat="server" CssClass="m-0 font-weight-bold"></asp:Label>,
                                <asp:Label ID="lblTime" runat="server" CssClass="m-0 font-weight-bold"></asp:Label>
                            </div>

                            <!-- /.col -->
                            <%-- <div class="col-sm-6">
                                <ol class="breadcrumb float-sm-right">
                                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                                    <li class="breadcrumb-item active">Starter Page</li>
                                </ol>
                            </div>
                            <!-- /.col -->--%>
                            <div class="col-sm-9" style="color: Red; font-weight: bold;">
                                <marquee id="mq" behavior="scroll" direction="left" onmouseover="this.stop()" onmouseout="this.start()"
                                    scrolldelay="100">
                                    || Website is under development stage & available for testing purpose only. ||</marquee>
                            </div>

                            <%-- <div class="col-sm-2">
                                <ol class="breadcrumb float-sm-right">

                                    <li class="breadcrumb-item active">
                                        <asp:Label ID="lblUserType" runat="server">Hi</asp:Label></li>
                                </ol>
                            </div>--%>
                        </div>
                        <!-- /.row -->
                    </div>
                    <!-- /.container-fluid -->
                </div>
                <!-- /.content-header -->
                <!-- Main content -->
                <div class="content">
                    <div class="container-fluid">
                        <div>
                            <asp:ContentPlaceHolder ID="CPH" runat="server">
                            </asp:ContentPlaceHolder>
                        </div>
                        <!-- /.row -->
                    </div>
                    <!-- /.container-fluid -->
                </div>
                <!-- /.content -->
            </div>
            <!-- /.content-wrapper -->

            <!-- Main Footer -->
            <div class="main-footer">
                <!-- To the right -->
                <div class="float-right d-none d-sm-inline">
                </div>
                <!-- Default to the left -->
                <strong>Home Department, Govt. of Bihar | All Rights Reserved | Software solution provided and designed by NIC-Bihar</strong>
                <br />


            </div>
        </div>
        <!-- ./wrapper -->


    </form>
    <!-- REQUIRED SCRIPTS -->

    <script src="<%=ResolveClientUrl("~/plugins/bootstrap/js/bootstrap.bundle.min.js")%>"></script>
    <!-- jquery-validation -->
    <script src="<%=ResolveClientUrl("~/plugins/jquery-validation/jquery.validate.min.js")%>"></script>
    <script src="<%=ResolveClientUrl("~/plugins/jquery-validation/additional-methods.min.js")%>"></script>

    <script src="<%=ResolveClientUrl("~/dist/js/adminlte.min.js")%>"></script>



    <script>
        $(document).ready(function () {
            ShowTime();
        });
        function ShowTime() {
            var dt = new Date();
            document.getElementById("lblTime").innerHTML = dt.toLocaleTimeString();
            /*window.setTimeout("ShowTime()", 1000);*/ // Here 1000(milliseconds) means one 1 Sec
            window.setTimeout(ShowTime, 1000);
        }
    </script>


</body>

</html>
